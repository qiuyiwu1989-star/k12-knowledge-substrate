{"id": "ca_3qUDGGxz", "discipline": "历史", "track": "MATRIX", "strand": "综合探究：历史问题的研究与论文习作", "topic": "综合探究：历史问题的研究与论文习作", "dimension": null, "statement": "能运用已学的历史知识和掌握的技能，对这一历史问题进行自主探究，并将自己的研究成果写一篇历史小论文", "verb": "运用", "object": "已学的历史知识和掌握的技能，对这一历史问题进行自主探究，并将自己的研究成果写一篇历史小论文", "type": "CONCEPTUAL", "literacy": [], "cognitive": "应用", "stageHint": {"min": "G10", "max": "G12"}, "courseType": "选修", "evidence": ["能在历史课堂或作业情境中完成：能运用已学的历史知识和掌握的技能，对这一历史问题进行自主探究，并将自己的研究成果"], "assessment": null, "evidenceSource": "curriculum-content-gaozhong", "reviewStatus": "llm-proposed", "reviewedBy": [], "deprecated": false, "supersededBy": null, "crosscutting": [], "practice": [], "provenance": {"srcSubject": "历史", "srcPage": 43, "srcCode": null, "srcTopic": "综合探究：历史问题的研究与论文习作", "srcCourse": "选修", "srcCourseNo": "", "srcText": "选定一个与历史有关的问题，自行拟订研究的计划和方法，在进行文献检索和综述的基础上，搜集、整理、辨析相关的历史材料，运用已学的历史知识和掌握的技能，对这一历史问题进行自主探究，并将自己的研究成果写一篇历史小论文；所写的论文有一定的逻辑层次，体现出论据与论点的内在联系，论文中的引文与注释符合规范。", "method": "gaozhong-textlayer-split"}, "schemaVersion": "0.1.0"}
{"id": "ca_PVA5bSTq", "discipline": "历史", "track": "MATRIX", "strand": "综合探究：历史问题的研究与论文习作", "topic": "综合探究：历史问题的研究与论文习作", "dimension": null, "statement": "能运用史料就是理解历史，需要秉持大胆怀疑、多源互证等原则", "verb": "运用", "object": "史料就是理解历史，需要秉持大胆怀疑、多源互证等原则", "type": "CONCEPTUAL", "literacy": [], "cognitive": "应用", "stageHint": {"min": "G10", "max": "G12"}, "courseType": "选修", "evidence": ["能在历史课堂或作业情境中完成：能运用史料就是理解历史，需要秉持大胆怀疑、多源互证等原则"], "assessment": null, "evidenceSource": "curriculum-content-gaozhong", "reviewStatus": "llm-proposed", "reviewedBy": [], "deprecated": false, "supersededBy": null, "crosscutting": [], "practice": [], "provenance": {"srcSubject": "历史", "srcPage": 45, "srcCode": null, "srcTopic": "综合探究：历史问题的研究与论文习作", "srcCourse": "选修", "srcCourseNo": "", "srcText": "史料是人们了解过去、认识历史的重要依据和基础。由于时代和认识上的局限，并非所有史料都能进入人们的视野。迄今为止，人们所能认识并可以搜集、运用的史料大体有文献、实物、口述、图像等类别。搜集和整理不同类别史料的方法有所不同，但却有共同的原则。运用史料就是理解历史，需要秉持大胆怀疑、多源互证等原则。", "method": "gaozhong-textlayer-split"}, "schemaVersion": "0.1.0"}
{"id": "ca_WmVyBYmV", "discipline": "历史", "track": "MATRIX", "strand": "文献史料研读", "topic": "文献史料研读", "dimension": null, "statement": "能知道它是史料中最重要的部分", "verb": "说出", "object": "能知道它是史料中最重要的部分", "type": "CONCEPTUAL", "literacy": [], "cognitive": "掌握", "stageHint": {"min": "G10", "max": "G12"}, "courseType": "选修", "evidence": ["能在历史课堂或作业情境中完成：能知道它是史料中最重要的部分"], "assessment": null, "evidenceSource": "curriculum-content-gaozhong", "reviewStatus": "llm-proposed", "reviewedBy": [], "deprecated": false, "supersededBy": null, "crosscutting": [], "practice": [], "provenance": {"srcSubject": "历史", "srcPage": 45, "srcCode": null, "srcTopic": "文献史料研读", "srcCourse": "选修", "srcCourseNo": "", "srcText": "依据主要的文献史料类别，选择有代表性的史料进行研读；认识文献史料的价值，知道它是史料中最重要的部分；了解搜集和运用文献史料研究历史的方法。所涉及的主要文献史料包括：史书；档案与文书；文集、笔记、书信与日记；地方史志；报刊；碑铭与简牍；族谱、契约、账簿等。", "method": "gaozhong-textlayer-split"}, "schemaVersion": "0.1.0"}
