{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yongle.school/k12/schema/edge.schema.json",
  "title": "L0 先修依赖边 (Prerequisite Edge)",
  "description": "anchorId 依赖 prerequisiteId。反向读即『解锁』。只有 DAG 档锚点允许 hard 边。",
  "type": "object",
  "additionalProperties": false,
  "required": ["anchorId", "prerequisiteId", "strength", "reason", "evidence", "reviewStatus", "schemaVersion"],
  "properties": {
    "anchorId": { "type": "string", "pattern": "^ca_[A-Za-z0-9]{8}$" },
    "prerequisiteId": { "type": "string", "pattern": "^ca_[A-Za-z0-9]{8}$" },
    "strength": {
      "type": "string",
      "enum": ["hard", "soft"],
      "description": "hard = 没有它就学不了。hard 边必须有至少一条非 llm 证据——校验器强制。"
    },
    "reason": {
      "type": "string",
      "minLength": 6,
      "maxLength": 80,
      "description": "一句话说清为什么。写不出具体理由的边，就是不该存在的边。"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "description": "三源证据。全部只有 llm 的边不许标 hard。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "detail"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["edition-order", "standard-hierarchy", "cooccurrence", "expert", "llm"],
            "description": "edition-order=多版本教材编排共识偏序(最可信,可自动化)；standard-hierarchy=课标内在层级；cooccurrence=错题共现统计；expert=老师判断；llm=模型提议(仅兜底)"
          },
          "detail": { "type": "string", "minLength": 2, "maxLength": 120 }
        }
      }
    },
    "reviewStatus": {
      "type": "string",
      "enum": ["llm-proposed", "auto-confirmed", "expert-confirmed", "disputed"],
      "description": "三源一致的边可直接 auto-confirmed，不占老师的复核时间。这是把 24 人×20 小时压下来的关键。"
    },
    "reviewedBy": {
      "type": "array",
      "items": { "type": "string", "pattern": "^(teacher|editor|ai):[A-Za-z0-9_.-]+$" }
    },
    "schemaVersion": { "type": "string", "const": "0.1.0" }
  }
}
