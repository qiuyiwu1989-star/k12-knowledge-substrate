{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yongle.school/k12/schema/anchor.schema.json",
  "title": "L0 能力锚点 (Capability Anchor)",
  "description": "底座的唯一稳定 ID 空间。一个锚点 = 一条可判定的能力断言。档案层(L3)的所有掌握记录都以 anchor.id 为谓词宾语。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "discipline",
    "track",
    "strand",
    "statement",
    "verb",
    "object",
    "type",
    "cognitive",
    "evidence",
    "reviewStatus",
    "schemaVersion"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ca_[A-Za-z0-9]{8}$",
      "description": "无语义、永不复用。禁止编入学科/年级/单元——那些都会变。"
    },
    "discipline": {
      "type": "string",
      "enum": [
        "语文",
        "数学",
        "英语",
        "物理",
        "化学",
        "生物学",
        "历史",
        "地理",
        "道德与法治",
        "思想政治",
        "科学",
        "信息科技",
        "劳动",
        "艺术",
        "体育与健康"
      ]
    },
    "track": {
      "type": "string",
      "enum": [
        "DAG",
        "LIST",
        "MATRIX"
      ],
      "description": "结构档位。DAG=强先修(数理化)；LIST=清单/覆盖(语文字词篇目、英语词表)；MATRIX=能力维度×主题(史地生政科)。决定该锚点允许存在什么边——校验器强制执行。"
    },
    "strand": {
      "type": "string",
      "minLength": 2,
      "maxLength": 30,
      "description": "课标领域，如 数与代数 / 识字与写字 / 物质的性质与应用"
    },
    "topic": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 40,
      "description": "主题。MATRIX 档必填(如 秦汉/唐宋)；DAG 档可空。"
    },
    "dimension": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 30,
      "description": "能力维度。MATRIX 档必填(如 史料实证/时空观念)。"
    },
    "statement": {
      "type": "string",
      "minLength": 8,
      "maxLength": 60,
      "description": "可判定的能力断言。必须能对一个具体孩子在某一时刻回答『会/不会/多大程度』。校验器用 decidability 过滤器强制执行——章节名、能力泛称一律拒绝。"
    },
    "verb": {
      "type": "string",
      "minLength": 1,
      "maxLength": 6,
      "description": "行为动词。与 object 共同构成去重签名。"
    },
    "object": {
      "type": "string",
      "minLength": 2,
      "maxLength": 40,
      "description": "作用对象。与 verb 共同构成去重签名——防止 Marble 那种『同一个名字出现 5 次』。"
    },
    "type": {
      "type": "string",
      "enum": [
        "CONCEPTUAL",
        "PROCEDURAL",
        "REPRESENTATIONAL",
        "LANGUAGE",
        "META"
      ]
    },
    "literacy": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 4,
      "description": "2022 课标核心素养标签。是标签不是结构——不要拿它当分类主键。"
    },
    "cognitive": {
      "type": "string",
      "enum": [
        "了解",
        "理解",
        "掌握",
        "应用"
      ],
      "description": "课标行为动词分级。"
    },
    "stageHint": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "description": "学段提示，非权威。真正的年级来自 L2 编排层(教材版本×年级)，同一锚点在不同教材落在不同年级。这里只给一个用于排序和兜底的粗略区间。",
      "properties": {
        "min": {
          "type": "string",
          "pattern": "^G(1[0-2]|[1-9])$"
        },
        "max": {
          "type": "string",
          "pattern": "^G(1[0-2]|[1-9])$"
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "string",
        "minLength": 4,
        "maxLength": 60
      },
      "description": "掌握证据。每条都必须是可观察的行为，不是感受。"
    },
    "assessment": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 120,
      "description": "自然语言检核问句。可含 {{name}} 占位符，展示前必须替换或剥离。"
    },
    "reviewStatus": {
      "type": "string",
      "enum": [
        "llm-proposed",
        "ai-reviewed",
        "ai-adjudicated",
        "auto-confirmed",
        "expert-confirmed",
        "disputed"
      ],
      "description": "可信度分档，从低到高：\n· llm-proposed    模型提议，未经任何复核。禁止被 L3 档案引用。\n· ai-reviewed     经 AI 复审但未裁定，仍不可用。\n· disputed        机械闸与 AI 判断冲突，或原句本身有问题。\n· ai-adjudicated  **AI 带全部材料做过裁定，计入可用，但人未签字。**\n                  用户明示「AI 先判、人有异议再改」时才产生这一档。\n                  它与 auto-confirmed 的区别必须保留：后者是判定客观、\n                  根本不需要人；前者是需要人、只是人还没看。混为一谈，\n                  「异议」就无从提起，因为没有东西标着待异议。\n· auto-confirmed  判定客观（写对/读对/背下来），无需教师复核。\n· expert-confirmed 教师当面确认过。"
    },
    "reviewedBy": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(teacher|editor|ai):[A-Za-z0-9_.-]+$"
      },
      "description": "谁复核的。老师的复核痕迹累积起来就是他自己的教学序列 IP —— 这个字段是复核者愿意干活的理由，别省。"
    },
    "deprecated": {
      "type": "boolean",
      "default": false
    },
    "supersededBy": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^ca_[A-Za-z0-9]{8}$",
      "description": "弃用时必填。档案里有几十万条引用，锚点只能弃用不能删除，否则历史记录悬空。"
    },
    "schemaVersion": {
      "type": "string",
      "const": "0.1.0"
    },
    "crosscutting": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "patterns",
          "cause-effect",
          "scale-proportion",
          "systems",
          "matter-energy",
          "structure-function",
          "stability-change"
        ]
      },
      "maxItems": 2,
      "description": "跨学科通用概念。跨界不靠前置边表达（那种关系罕见且易造假），靠「练的是同一件事」。见 docs/crosscutting.md"
    },
    "practice": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "asking-questions",
          "modeling",
          "investigating",
          "analyzing-data",
          "math-computational",
          "explaining-designing",
          "argumentation",
          "communicating"
        ]
      },
      "maxItems": 2,
      "description": "学生要做哪类动作。与 crosscutting 正交。"
    },
    "stageTargets": {
      "type": "array",
      "description": "分学段累计目标量。仅清单类锚点有。注意这是数量目标不是字表切分——课标不说哪些字属于哪个学段。",
      "items": {
        "type": "object",
        "required": [
          "stage",
          "target"
        ],
        "properties": {
          "stage": {
            "type": "string"
          },
          "band": {
            "type": "string"
          },
          "target": {
            "type": "integer"
          }
        }
      }
    },
    "courseType": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "必修",
        "选择性必修",
        "选修",
        null
      ],
      "description": "高中课程类型。**义务教育没有这个维度，而它对个人档案是本质区别**：\n必修是所有学生都该有的，选修不是。不记这一维，档案里「他没掌握 X」就分不清\n是没学过还是学了没会。义务教育锚点一律为 null。"
    },
    "endorsements": {
      "type": "array",
      "description": "教师签字记录。标「成立」并署名的复核会追加一条。\n**这是 expert-confirmed 的凭据** —— 那一档的含义是「有具体的人对这条负责」，\n所以必须留得下是谁、什么时候、说了什么。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "by"
        ],
        "properties": {
          "by": {
            "type": "string",
            "minLength": 1,
            "description": "签字人，不得为空"
          },
          "at": {
            "type": [
              "string",
              "null"
            ]
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "disputes": {
      "type": "array",
      "description": "复核异议记录。标「学段不对/表述要改/不该收」时追加。\n不删条目、只降级 —— 「谁在什么时候说它不对」必须查得到。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "issue": {
            "type": [
              "string",
              "null"
            ]
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          },
          "by": {
            "type": [
              "string",
              "null"
            ]
          },
          "at": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
