{
  "name": "k12-knowledge-substrate",
  "version": "0.1.0",
  "description": "K12 全学科知识底座 —— 让所有教育产品的个人档案写在同一套 ID 空间里的坐标系",
  "private": true,
  "type": "module",
  "license": "(ODbL-1.0 AND CC-BY-SA-4.0)",
  "scripts": {
    "validate": "node scripts/validate.mjs --warn",
    "selftest": "node scripts/lib/decidability.mjs && node scripts/selftest.mjs",
    "manifest": "node scripts/manifest.mjs",
    "check": "npm run no-dup-defs && npm run selftest && npm run review-loop && npm run manifest && node scripts/sync-docs.mjs --check && npm run validate && npm run fw-report",
    "sync-docs": "node scripts/sync-docs.mjs",
    "strip-srctext": "node scripts/strip-srctext.mjs",
    "review-loop": "node scripts/review-loop-test.mjs",
    "fw-report": "node scripts/fw-report.mjs",
    "no-dup-defs": "node scripts/no-dup-defs.mjs",
    "quality-levels": "python3 tools/extract_quality_levels.py"
  }
}
